# Which broker to trade through: "ibkr" (default — free paper trading, no
# funding required), "topstepx" (TopStep's own platform — what a real
# TopStep account actually runs on; no demo, requires TOPSTEPX_ALLOW_LIVE=true
# below), or "tradovate" (legacy — only relevant for a Tradovate account you
# opened yourself outside TopStep). See IBKR.md / README.md.
BROKER=ibkr

# ---------------------------------------------------------------------------
# Interactive Brokers (BROKER=ibkr) — connects to a running TWS or IB
# Gateway process, not a hosted REST API. See IBKR.md for how to run one
# headless (e.g. on Railway via a community IB Gateway + IBC Docker image).
# ---------------------------------------------------------------------------
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1
# Comma-separated paper account IDs (start with "DU") to trade. Leave blank
# to trade every paper account returned by the login. Get these from your
# IBKR "My Accounts" page, or from your dashboard's My Accounts page once
# you've entered them there.
IBKR_ACCOUNT_NAMES=

# ---------------------------------------------------------------------------
# TopstepX (BROKER=topstepx) — this is what a real TopStep account actually
# runs on today. Requires a separate $29/mo TopstepX API subscription
# (billed apart from your TopStep subscription) — generate an API key in
# TopstepX platform settings. NO SANDBOX: every order placed is real money
# against your real account the instant TOPSTEPX_ALLOW_LIVE=true is set.
# Also: TopStep bans VPS/cloud execution — run this on your own local,
# actively-monitored machine, never Railway or another cloud host.
# ---------------------------------------------------------------------------
TOPSTEPX_USERNAME=
TOPSTEPX_API_KEY=
# Set to "true" only once you're intentionally ready to trade real money.
TOPSTEPX_ALLOW_LIVE=false
# Comma-separated list of TopstepX account names to trade. Leave blank to
# trade every active account under this login.
TOPSTEPX_ACCOUNT_NAMES=

# ---------------------------------------------------------------------------
# Tradovate (BROKER=tradovate) — LEGACY. TopStep replaced Tradovate/
# NinjaTrader routing with TopstepX; as of Feb 2026 there are no TopStep
# accounts left running on Tradovate. Only use this for a Tradovate account
# you opened yourself, separate from TopStep. Requires a funded live
# Tradovate account + the $25/mo API Access add-on before
# trader.tradovate.com will show the key-generation UI.
# ---------------------------------------------------------------------------
# "demo" for a practice Tradovate account, "live" for your real TopStep
# account. "live" also requires TRADOVATE_ALLOW_LIVE=true below — this is a
# deliberate two-step opt-in so a real account is never traded by accident.
TRADOVATE_ENV=demo
# Set to "true" only once you're intentionally ready to trade a real TopStep
# account. Leave unset/false while testing.
TRADOVATE_ALLOW_LIVE=false
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SEC=
TRADOVATE_DEVICE_ID=jj-bot-01

# Comma-separated list of Tradovate account names to trade (supports
# multiple accounts under one login — e.g. several TopStep evals/funded
# accounts). Leave blank to trade every active account on the login.
TRADOVATE_ACCOUNT_NAMES=

# Bot API server (jj_bot/api_server.py) — used by the dashboard's
# "Test Trade" panel and by run_live.py's HTTP status endpoint.
BOT_API_HOST=0.0.0.0
BOT_API_PORT=8787
# Comma-separated list of origins allowed to call the bot API (your Vercel
# dashboard URL). Use * only for local testing.
BOT_API_CORS_ORIGINS=*

# Supabase — lets the dashboard show trades live instead of a static file
# that only updates on redeploy. Run supabase/schema.sql once in your
# Supabase project, then set these here (on whatever host runs the Python
# bot — Railway, etc). SERVICE ROLE KEY IS SECRET: it bypasses row-level
# security, never put it in the dashboard/Vercel env or in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Crash alert email — sent if the live worker exits on an unhandled
# exception (auth failure, WebSocket death, etc). Uses Gmail SMTP with an
# App Password (myaccount.google.com/apppasswords, requires 2FA), never a
# regular account password. Leave blank to disable (crash alerts skipped,
# logged only).
SMTP_USER=
SMTP_PASSWORD=
# Recipient address. Defaults to SMTP_USER if left blank.
ALERT_EMAIL_TO=
